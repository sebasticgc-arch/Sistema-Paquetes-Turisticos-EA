<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.1" xmlns:uml="http://schema.omg.org/spec/UML/2.1" xmlns:xmi="http://schema.omg.org/spec/XMI/2.1">
  <xmi:Documentation exporter="Enterprise Architect" exporterVersion="8.0"/>
  <uml:Model xmi:type="uml:Model" xmi:id="EAPK_ROOT" name="Sistema de Paquetes Turisticos">
    
    <packagedElement xmi:type="uml:Package" xmi:id="PKG_MAIN" name="Sistema de Paquetes Turisticos" visibility="public">
      
      <!-- ==================== ACTORES ==================== -->
      <packagedElement xmi:type="uml:Actor" xmi:id="ACTOR_CLIENTE" name="Cliente" visibility="public"/>
      <packagedElement xmi:type="uml:Actor" xmi:id="ACTOR_ADMIN" name="Administrador" visibility="public"/>
      <packagedElement xmi:type="uml:Actor" xmi:id="ACTOR_OPERADOR" name="Operador Turistico" visibility="public"/>
      
      <!-- ==================== CASOS DE USO ==================== -->
      <packagedElement xmi:type="uml:UseCase" xmi:id="UC_BUSCAR" name="Buscar paquete" visibility="public"/>
      <packagedElement xmi:type="uml:UseCase" xmi:id="UC_ARMAR" name="Armar paquete" visibility="public"/>
      <packagedElement xmi:type="uml:UseCase" xmi:id="UC_AJUSTAR" name="Ajustar presupuesto" visibility="public"/>
      <packagedElement xmi:type="uml:UseCase" xmi:id="UC_COMPARAR" name="Comparar opciones" visibility="public"/>
      <packagedElement xmi:type="uml:UseCase" xmi:id="UC_RESERVAR" name="Reservar paquete" visibility="public"/>
      <packagedElement xmi:type="uml:UseCase" xmi:id="UC_CALCULAR" name="Calcular precio" visibility="public"/>
      <packagedElement xmi:type="uml:UseCase" xmi:id="UC_CONFIRMAR" name="Confirmar reserva" visibility="public"/>
      <packagedElement xmi:type="uml:UseCase" xmi:id="UC_VERIFICAR" name="Verificar disponibilidad" visibility="public"/>
      <packagedElement xmi:type="uml:UseCase" xmi:id="UC_NOTIFICAR" name="Notificar operadores" visibility="public"/>
      <packagedElement xmi:type="uml:UseCase" xmi:id="UC_GESTIONAR" name="Gestionar reservas" visibility="public"/>
      <packagedElement xmi:type="uml:UseCase" xmi:id="UC_CONFIRMAR_MANUAL" name="Confirmar manual" visibility="public"/>
      <packagedElement xmi:type="uml:UseCase" xmi:id="UC_RECOMENDAR" name="Recomendar alternativas" visibility="public"/>
      <packagedElement xmi:type="uml:UseCase" xmi:id="UC_REGISTRAR" name="Registrar cliente" visibility="public"/>
      
      <!-- ==================== ASOCIACIONES CASOS DE USO ==================== -->
      <packagedElement xmi:type="uml:Association" xmi:id="ASSOC_C1" memberEnd="ASSOC_C1_END1 ASSOC_C1_END2">
        <ownedEnd xmi:type="uml:Property" xmi:id="ASSOC_C1_END1" type="ACTOR_CLIENTE"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="ASSOC_C1_END2" type="UC_BUSCAR"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Association" xmi:id="ASSOC_C2" memberEnd="ASSOC_C2_END1 ASSOC_C2_END2">
        <ownedEnd xmi:type="uml:Property" xmi:id="ASSOC_C2_END1" type="ACTOR_CLIENTE"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="ASSOC_C2_END2" type="UC_ARMAR"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Association" xmi:id="ASSOC_C3" memberEnd="ASSOC_C3_END1 ASSOC_C3_END2">
        <ownedEnd xmi:type="uml:Property" xmi:id="ASSOC_C3_END1" type="ACTOR_CLIENTE"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="ASSOC_C3_END2" type="UC_RESERVAR"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Association" xmi:id="ASSOC_A1" memberEnd="ASSOC_A1_END1 ASSOC_A1_END2">
        <ownedEnd xmi:type="uml:Property" xmi:id="ASSOC_A1_END1" type="ACTOR_ADMIN"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="ASSOC_A1_END2" type="UC_GESTIONAR"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Association" xmi:id="ASSOC_O1" memberEnd="ASSOC_O1_END1 ASSOC_O1_END2">
        <ownedEnd xmi:type="uml:Property" xmi:id="ASSOC_O1_END1" type="ACTOR_OPERADOR"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="ASSOC_O1_END2" type="UC_VERIFICAR"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Association" xmi:id="ASSOC_O2" memberEnd="ASSOC_O2_END1 ASSOC_O2_END2">
        <ownedEnd xmi:type="uml:Property" xmi:id="ASSOC_O2_END1" type="ACTOR_OPERADOR"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="ASSOC_O2_END2" type="UC_NOTIFICAR"/>
      </packagedElement>
      
      <!-- ==================== INCLUDE/EXTEND ==================== -->
      <packagedElement xmi:type="uml:Include" xmi:id="INCL_1" addition="UC_REGISTRAR" includingUseCase="UC_RESERVAR"/>
      <packagedElement xmi:type="uml:Include" xmi:id="INCL_2" addition="UC_CALCULAR" includingUseCase="UC_RESERVAR"/>
      <packagedElement xmi:type="uml:Include" xmi:id="INCL_3" addition="UC_VERIFICAR" includingUseCase="UC_RESERVAR"/>
      <packagedElement xmi:type="uml:Include" xmi:id="INCL_4" addition="UC_NOTIFICAR" includingUseCase="UC_CONFIRMAR"/>
      <packagedElement xmi:type="uml:Extend" xmi:id="EXT_1" extension="UC_CONFIRMAR_MANUAL" extendedUseCase="UC_CONFIRMAR"/>
      <packagedElement xmi:type="uml:Extend" xmi:id="EXT_2" extension="UC_RECOMENDAR" extendedUseCase="UC_AJUSTAR"/>
      
      <!-- ==================== CLASES PARA SECUENCIA/COLABORACION ==================== -->
      <packagedElement xmi:type="uml:Class" xmi:id="CLASS_UI" name="InterfazUsuario" visibility="public">
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_UI1" name="solicitarReserva()"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_UI2" name="mostrarConfirmacion()"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CLASS_CTL" name="ControladorReservas" visibility="public">
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_CTL1" name="registrarReserva()"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_CTL2" name="confirmarReserva()"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CLASS_PRC" name="GestorPrecios" visibility="public">
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_PRC1" name="calcularPrecio()"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_PRC2" name="aplicarRecargo()"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CLASS_OPE" name="SistemaOperadores" visibility="public">
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_OPE1" name="verificarDisponibilidad()"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_OPE2" name="confirmarReserva()"/>
      </packagedElement>
      
      <!-- ==================== ACTIVIDAD ==================== -->
      <packagedElement xmi:type="uml:Activity" xmi:id="ACT_MAIN" name="Reserva de Paquete Turistico" visibility="public">
        <region xmi:type="uml:ActivityPartition" xmi:id="PART_CLIENTE" name="Cliente"/>
        <region xmi:type="uml:ActivityPartition" xmi:id="PART_SISTEMA" name="Sistema"/>
        <region xmi:type="uml:ActivityPartition" xmi:id="PART_ADMIN" name="Administrador"/>
        
        <node xmi:type="uml:InitialNode" xmi:id="N_INIT"/>
        <node xmi:type="uml:OpaqueAction" xmi:id="N_BUSCAR" name="Buscar paquete"/>
        <node xmi:type="uml:OpaqueAction" xmi:id="N_COMPARAR" name="Comparar referencias"/>
        <node xmi:type="uml:OpaqueAction" xmi:id="N_ARMAR" name="Armar/ajustar paquete"/>
        <node xmi:type="uml:DecisionNode" xmi:id="N_DECISION1" name="Se ajusta?"/>
        <node xmi:type="uml:OpaqueAction" xmi:id="N_RECOMENDAR" name="Recomendar"/>
        <node xmi:type="uml:OpaqueAction" xmi:id="N_SOLICITAR" name="Solicitar reserva"/>
        <node xmi:type="uml:OpaqueAction" xmi:id="N_VERIFICAR" name="Verificar disponibilidad"/>
        <node xmi:type="uml:DecisionNode" xmi:id="N_DECISION2" name="Disponible?"/>
        <node xmi:type="uml:OpaqueAction" xmi:id="N_CALCULAR" name="Calcular precio"/>
        <node xmi:type="uml:DecisionNode" xmi:id="N_DECISION3" name="Tipo cliente?"/>
        <node xmi:type="uml:OpaqueAction" xmi:id="N_RECARGO_NAC" name="Recargo Nacional"/>
        <node xmi:type="uml:OpaqueAction" xmi:id="N_RECARGO_EXT" name="Recargo Extranjero"/>
        <node xmi:type="uml:MergeNode" xmi:id="N_MERGE"/>
        <node xmi:type="uml:OpaqueAction" xmi:id="N_ENVIAR" name="Enviar confirmacion"/>
        <node xmi:type="uml:OpaqueAction" xmi:id="N_MANUAL" name="Confirmar manual"/>
        <node xmi:type="uml:ActivityFinalNode" xmi:id="N_FINAL"/>
        
        <edge xmi:type="uml:ControlFlow" source="N_INIT" target="N_BUSCAR"/>
        <edge xmi:type="uml:ControlFlow" source="N_BUSCAR" target="N_COMPARAR"/>
        <edge xmi:type="uml:ControlFlow" source="N_COMPARAR" target="N_ARMAR"/>
        <edge xmi:type="uml:ControlFlow" source="N_ARMAR" target="N_DECISION1"/>
        <edge xmi:type="uml:ControlFlow" source="N_DECISION1" target="N_RECOMENDAR"><guard xmi:type="uml:LiteralString" value="No"/></edge>
        <edge xmi:type="uml:ControlFlow" source="N_RECOMENDAR" target="N_ARMAR"/>
        <edge xmi:type="uml:ControlFlow" source="N_DECISION1" target="N_SOLICITAR"><guard xmi:type="uml:LiteralString" value="Si"/></edge>
        <edge xmi:type="uml:ControlFlow" source="N_SOLICITAR" target="N_VERIFICAR"/>
        <edge xmi:type="uml:ControlFlow" source="N_VERIFICAR" target="N_DECISION2"/>
        <edge xmi:type="uml:ControlFlow" source="N_DECISION2" target="N_RECOMENDAR"><guard xmi:type="uml:LiteralString" value="No"/></edge>
        <edge xmi:type="uml:ControlFlow" source="N_DECISION2" target="N_CALCULAR"><guard xmi:type="uml:LiteralString" value="Si"/></edge>
        <edge xmi:type="uml:ControlFlow" source="N_CALCULAR" target="N_DECISION3"/>
        <edge xmi:type="uml:ControlFlow" source="N_DECISION3" target="N_RECARGO_NAC"><guard xmi:type="uml:LiteralString" value="Nacional"/></edge>
        <edge xmi:type="uml:ControlFlow" source="N_DECISION3" target="N_RECARGO_EXT"><guard xmi:type="uml:LiteralString" value="Extranjero"/></edge>
        <edge xmi:type="uml:ControlFlow" source="N_RECARGO_NAC" target="N_MERGE"/>
        <edge xmi:type="uml:ControlFlow" source="N_RECARGO_EXT" target="N_MERGE"/>
        <edge xmi:type="uml:ControlFlow" source="N_MERGE" target="N_ENVIAR"/>
        <edge xmi:type="uml:ControlFlow" source="N_ENVIAR" target="N_MANUAL"/>
        <edge xmi:type="uml:ControlFlow" source="N_MANUAL" target="N_FINAL"/>
      </packagedElement>
      
      <!-- ==================== INTERACCION SECUENCIA ==================== -->
      <packagedElement xmi:type="uml:Interaction" xmi:id="INTER_SEQ" name="Confirmacion de Reserva" visibility="public">
        <lifeline xmi:type="uml:Lifeline" xmi:id="LL_CLIENTE" name="Cliente" represents="ACTOR_CLIENTE"/>
        <lifeline xmi:type="uml:Lifeline" xmi:id="LL_UI" name=":InterfazUsuario" represents="CLASS_UI"/>
        <lifeline xmi:type="uml:Lifeline" xmi:id="LL_CTL" name=":ControladorReservas" represents="CLASS_CTL"/>
        <lifeline xmi:type="uml:Lifeline" xmi:id="LL_PRC" name=":GestorPrecios" represents="CLASS_PRC"/>
        <lifeline xmi:type="uml:Lifeline" xmi:id="LL_OPE" name=":SistemaOperadores" represents="CLASS_OPE"/>
        
        <message xmi:type="uml:Message" xmi:id="MSG1" name="1: solicitarReserva(paquete)" messageSort="synchCall" sendEvent="LL_CLIENTE" receiveEvent="LL_UI"/>
        <message xmi:type="uml:Message" xmi:id="MSG2" name="1.1: registrarReserva()" messageSort="synchCall" sendEvent="LL_UI" receiveEvent="LL_CTL"/>
        <message xmi:type="uml:Message" xmi:id="MSG3" name="1.1.1: calcularPrecio()" messageSort="synchCall" sendEvent="LL_CTL" receiveEvent="LL_PRC"/>
        <message xmi:type="uml:Message" xmi:id="MSG4" name="1.1.2: precioFinal" messageSort="reply" sendEvent="LL_PRC" receiveEvent="LL_CTL"/>
        <message xmi:type="uml:Message" xmi:id="MSG5" name="1.1.3: verificarDisponibilidad()" messageSort="synchCall" sendEvent="LL_CTL" receiveEvent="LL_OPE"/>
        <message xmi:type="uml:Message" xmi:id="MSG6" name="1.1.4: disponible" messageSort="reply" sendEvent="LL_OPE" receiveEvent="LL_CTL"/>
        <message xmi:type="uml:Message" xmi:id="MSG7" name="1.1.5: confirmarReserva()" messageSort="synchCall" sendEvent="LL_CTL" receiveEvent="LL_OPE"/>
        <message xmi:type="uml:Message" xmi:id="MSG8" name="1.1.6: confirmacion" messageSort="reply" sendEvent="LL_OPE" receiveEvent="LL_CTL"/>
        <message xmi:type="uml:Message" xmi:id="MSG9" name="1.2: mostrarConfirmacion()" messageSort="reply" sendEvent="LL_CTL" receiveEvent="LL_UI"/>
      </packagedElement>
      
      <!-- ==================== COLABORACION ==================== -->
      <packagedElement xmi:type="uml:Collaboration" xmi:id="COLL_MAIN" name="Confirmacion - Colaboracion" visibility="public">
        <collaborationRole xmi:type="uml:ConnectableElement" xmi:id="COLL_UI" name="ui" type="CLASS_UI"/>
        <collaborationRole xmi:type="uml:ConnectableElement" xmi:id="COLL_CTL" name="ctl" type="CLASS_CTL"/>
        <collaborationRole xmi:type="uml:ConnectableElement" xmi:id="COLL_PRC" name="prc" type="CLASS_PRC"/>
        <collaborationRole xmi:type="uml:ConnectableElement" xmi:id="COLL_OPE" name="ope" type="CLASS_OPE"/>
        <ownedBehavior xmi:type="uml:Interaction" xmi:id="INTER_COLL" name="Flujo Colaboracion">
          <message xmi:type="uml:Message" xmi:id="CMSG1" name="1: solicitarReserva()" messageSort="synchCall"/>
          <message xmi:type="uml:Message" xmi:id="CMSG2" name="1.1: registrarReserva()" messageSort="synchCall"/>
          <message xmi:type="uml:Message" xmi:id="CMSG3" name="1.1.1: calcularPrecio()" messageSort="synchCall"/>
          <message xmi:type="uml:Message" xmi:id="CMSG4" name="1.1.2: verificarDisponibilidad()" messageSort="synchCall"/>
          <message xmi:type="uml:Message" xmi:id="CMSG5" name="1.1.3: confirmarReserva()" messageSort="synchCall"/>
        </ownedBehavior>
      </packagedElement>
    </packagedElement>
  </uml:Model>
</xmi:XMI>